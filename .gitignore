# Datasets — never commit
data/

# Jupyter checkpoints
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python compiled files
__pycache__/
*.pyc
*.pyo

# Build artifacts
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
.venv/

# Secrets
.env
*.key
*.pem

# IDE
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

.claude/

# Internal working docs — build specs, project context, teammate handoffs.
# Not part of the deliverable; some carry infrastructure detail we don't publish.
#
# These are PATTERNS, not filenames, on purpose: a new spec or handoff is ignored
# the moment it's created. Listing files one by one meant every new handoff was
# unprotected until someone remembered to add it — which is one `git add -A` too
# late. Add new internal docs under these names and they're covered automatically.
TO_build_*.md
PROJECT_CONTEXT.md
HANDOFF_*.md
handoff_*.md
MRI_upload.md

# Env files (any level)
.env
.env.*
!.env.example
backend/.env

# Node / frontend build output
node_modules/
frontend/dist/
frontend/.vite/
