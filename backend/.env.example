# Copy this file to backend/.env and fill in the real values from your Supabase project.
# backend/.env is gitignored and must NEVER be committed.

# Postgres connection string (Supabase -> Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project URL and API key (Supabase -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Storage bucket for MRI/audio uploads (create as PRIVATE, 50MB limit, no MIME restriction)
SUPABASE_BUCKET=patient-uploads

# Secret used to sign JWTs. Generate a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret

# Where the Phase 1 model pickles (qsvm_model.pkl, svm_model.pkl) are found.
# Leave as-is locally: docker-compose mounts the repo's ./results here read-only,
# and running uvicorn outside Docker falls back to <repo>/results automatically.
# NOTE for Render: the Docker build context is ./backend, so ./results is NOT
# baked into the image — the deploy pass must ship the pickles or point this at
# a path that has them, or /health will report model:"error".
MODEL_DIR=/model
